# Copy to .env and fill in later. Never commit .env or real credentials.
# Shared Azure connection for explicit tools.azure_pilot smoke calls and the
# separately enabled tools.session_reflection worker. Offline tools stay offline.

# HTTPS resource origin only (no /openai suffix); runner adds /openai/v1/responses.
# Do not include secret query strings.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Actual model/version for evaluation provenance; not necessarily the deployment name.
ASSESSMENT_MODEL_ID=
ASSESSMENT_MODEL_VERSION=

# Use the signed-in Azure CLI identity (az login); no API key or stored access token.
ASSESSMENT_AZURE_AUTH=azure_cli

# Synthetic smoke only. Real inference requires the separate local reflection
# policy's explicit enable command; this flag cannot enable real-session requests.
ASSESSMENT_ALLOW_SYNTHETIC_INFERENCE=false
# Synthetic maximum across this checkout's .pilot/model-attempts.jsonl ledger.
# Real reflection independently enforces 5 attempts/day and 2,000 output tokens.
# Includes failed calls; no automatic retries. Start with one smoke request.
ASSESSMENT_MAX_REQUESTS=16
# Per-request output-token ceiling, not a financial spending cap.
ASSESSMENT_MAX_OUTPUT_TOKENS=2000
