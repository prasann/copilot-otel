# Copy to .env and fill in. Never commit .env or real credentials.
# Azure model used by tools.coaching to normalize Chronicle reports.

# HTTPS resource origin only (no /openai suffix); the worker adds /openai/v1/responses.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Actual model ID recorded with each published item; not necessarily the deployment name.
COACHING_MODEL_ID=

# Use the signed-in Azure CLI identity (az login); no API key or stored access token.
COACHING_AZURE_AUTH=azure_cli
