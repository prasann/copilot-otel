{
  "type": "excalidraw",
  "version": 2,
  "source": "copilot",
  "elements": [
    {"id":"title","type":"text","x":40,"y":10,"width":1500,"height":70,"text":"Personal Copilot: daily reflection + separate operational telemetry","fontSize":26,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"subtitle","type":"text","x":40,"y":85,"width":1500,"height":45,"text":"DRAFT ONLY | VS Code first, Copilot desktop app second, CLI optional | No Docker dependency","fontSize":17,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"sources","type":"rectangle","x":310,"y":150,"width":980,"height":110,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"sources-text"}]},
    {"id":"sources-text","type":"text","x":330,"y":160,"width":940,"height":90,"text":"Coding-agent clients: capture capability must be proved per client/harness\nNative local history for reflection; approved OTLP metadata for operations","fontSize":18,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"sources"},
    {"id":"reflection","type":"rectangle","x":30,"y":330,"width":730,"height":1110,"strokeColor":"#107C10","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"id":"reflection-label","type":"text","x":60,"y":345,"width":670,"height":50,"text":"PRIMARY: local daily reflection","fontSize":20,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"capture","type":"rectangle","x":60,"y":420,"width":670,"height":150,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"capture-text"}]},
    {"id":"capture-text","type":"text","x":80,"y":435,"width":630,"height":120,"text":"Approved read-only capture adapter\nNative history + verified explicit completion/archive\nAllowed projects; version and coverage checks","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"capture"},
    {"id":"content","type":"rectangle","x":60,"y":630,"width":670,"height":150,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"content-text"}]},
    {"id":"content-text","type":"text","x":80,"y":645,"width":630,"height":120,"text":"Protected local snapshots + processing manifest\nCaptured content: 30 days; outside Git\nNative Copilot history is never auto-pruned","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"content"},
    {"id":"batch","type":"rectangle","x":60,"y":840,"width":670,"height":190,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"batch-text"}]},
    {"id":"batch-text","type":"text","x":80,"y":855,"width":630,"height":160,"text":"Daily native batch worker scheduled by launchd\nFinished revisions only; catch up after wake/login\nFacts + evidence-backed model assessment\nMODEL STEP BLOCKED pending provider approval","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"batch"},
    {"id":"reports","type":"rectangle","x":60,"y":1090,"width":670,"height":150,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"reports-text"}]},
    {"id":"reports-text","type":"text","x":80,"y":1105,"width":630,"height":120,"text":"Local structured assessments + daily Markdown report\nEvidence, uncertainty, coverage, one experiment\nRetain 90 days; read in VS Code","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"reports"},
    {"id":"reflection-note","type":"text","x":60,"y":1280,"width":670,"height":120,"text":"No active/idle-only session assessment. No productivity score.\nNo shell/tools for the assessor; no automatic instruction edits.\nSynthetic local-vs-Azure evaluation before real-content inference.","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"telemetry","type":"rectangle","x":840,"y":330,"width":730,"height":1110,"strokeColor":"#5C2D91","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"id":"telemetry-label","type":"text","x":870,"y":345,"width":670,"height":50,"text":"SUPPORTING: operational telemetry","fontSize":20,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"collector","type":"rectangle","x":870,"y":420,"width":670,"height":150,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"collector-text"}]},
    {"id":"collector-text","type":"text","x":890,"y":435,"width":630,"height":120,"text":"Native OTel Collector Contrib, supervised by launchd\nNormalize project accounting + allowlist metadata\nIndependent health checks; content capture OFF","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"collector"},
    {"id":"queue","type":"rectangle","x":870,"y":630,"width":670,"height":150,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"queue-text"}]},
    {"id":"queue-text","type":"text","x":890,"y":645,"width":630,"height":120,"text":"Disk-backed queue outside Git\nApproved metadata only; bounded storage\nBatch + retry after restart/reconnection","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"queue"},
    {"id":"azure","type":"rectangle","x":870,"y":840,"width":670,"height":190,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"azure-text"}]},
    {"id":"azure-text","type":"text","x":890,"y":855,"width":630,"height":160,"text":"Personal Azure subscription, separately approved\nOTLP ingestion + Azure Monitor / Application Insights\nHTTPS + Microsoft Entra authentication\nNo raw sessions or reflection reports in this path","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"azure"},
    {"id":"grafana","type":"rectangle","x":870,"y":1090,"width":670,"height":150,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"grafana-text"}]},
    {"id":"grafana-text","type":"text","x":890,"y":1105,"width":630,"height":120,"text":"Grafana inside the Azure portal\nProject usage, latency, errors, delivery health\nNo dedicated Managed Grafana by default","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"grafana"},
    {"id":"telemetry-note","type":"text","x":870,"y":1280,"width":670,"height":120,"text":"Telemetry is not productivity or outcome truth.\nProve attribution separately; no mapping joins.\nFailure here must not prevent a local daily reflection.","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"source-to-capture","type":"arrow","x":550,"y":265,"width":155,"height":150,"points":[[0,0],[0,40],[-155,40],[-155,150]],"strokeColor":"#0078D4","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"source-to-collector","type":"arrow","x":1050,"y":265,"width":155,"height":150,"points":[[0,0],[0,40],[155,40],[155,150]],"strokeColor":"#5C2D91","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"capture-to-content","type":"arrow","x":395,"y":575,"width":0,"height":50,"points":[[0,0],[0,50]],"strokeColor":"#0078D4","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"content-to-batch","type":"arrow","x":395,"y":785,"width":0,"height":50,"points":[[0,0],[0,50]],"strokeColor":"#107C10","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"batch-to-reports","type":"arrow","x":395,"y":1035,"width":0,"height":50,"points":[[0,0],[0,50]],"strokeColor":"#0078D4","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"collector-to-queue","type":"arrow","x":1205,"y":575,"width":0,"height":50,"points":[[0,0],[0,50]],"strokeColor":"#F7630C","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"queue-to-azure","type":"arrow","x":1205,"y":785,"width":0,"height":50,"points":[[0,0],[0,50]],"strokeColor":"#5C2D91","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"azure-to-grafana","type":"arrow","x":1205,"y":1035,"width":0,"height":50,"points":[[0,0],[0,50]],"strokeColor":"#0078D4","strokeWidth":2,"endArrowhead":"arrow"},
    {"id":"gate","type":"rectangle","x":30,"y":1480,"width":1540,"height":120,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"gate-text"}]},
    {"id":"gate-text","type":"text","x":50,"y":1500,"width":1500,"height":80,"text":"FIRST GATE: synthetic VS Code proof of passive capture, project identity, and explicit finished-session eligibility.\nNo real-content inference, new history sync, normal-work capture, or Azure deployment is authorized by this draft.","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"gate"}
  ],
