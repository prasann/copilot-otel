{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local synthetic assessment; not the dashboard export contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rubric_version", "session_id", "revision", "snapshot_sha256", "model", "segments", "limitations", "unknown_dimensions", "recommendations"],
  "properties": {
    "schema_version": {"const": 1},
    "rubric_version": {"const": "s4-v1"},
    "session_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "task_type", "event_ids", "outcome", "claims"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task_type": {"enum": ["implementation", "debugging", "planning", "exploration", "review", "other", "unknown"]},
          "event_ids": {"$ref": "#/$defs/references"},
          "outcome": {"enum": ["narrow_verification", "agent_claimed_completion", "partial", "unresolved", "unknown"]},
          "claims": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {"$ref": "#/$defs/claim"}
          }
        }
      }
    },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "unknown_dimensions": {
      "type": "array", "uniqueItems": true, "minItems": 3, "maxItems": 3,
      "items": {"enum": ["time_saved", "satisfaction", "understanding"]}
    },
    "recommendations": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence_ids": {"$ref": "#/$defs/references"}
        }
      }
    }
  },
  "$defs": {
    "references": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "text", "evidence_ids", "confidence"],
      "properties": {
        "kind": {"enum": ["observation", "interpretation", "unknown"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ids": {"$ref": "#/$defs/references"},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    }
  }
}
